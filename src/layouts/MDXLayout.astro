---
import type { MDXLayoutProps } from "astro";

import BaseLayout from "./BaseLayout.astro";
import Giscus from "@components/Giscus.astro";

type Props = MDXLayoutProps<{
  title: string;
}>;

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title + " - Lancern's Home"}>
  <main class="mdx">
    <header class="mdx-header">
      <h1 class="mdx-title">{frontmatter.title}</h1>
      <slot name="meta" />
    </header>
    <div class="mdx-body">
      <slot />
    </div>
  </main>
  <div class="mdx-footer">
    <slot name="footer" />
  </div>
  <div class="giscus-container">
    <Giscus />
  </div>
</BaseLayout>

<style>
  .mdx-header {
    margin-top: 24px;
    margin-bottom: 2.6em;
  }

  .mdx-title {
    text-align: center;
    margin-bottom: 12px;
  }

  .giscus-container {
    margin-top: 2em;
  }

  .mdx-footer {
    margin-top: 2em;
  }
</style>

<style is:global>
  .mdx-body {
    line-height: 1.5em;
  }

  .mdx-body h1,
  .mdx-body h2,
  .mdx-body h3,
  .mdx-body h4,
  .mdx-body h5,
  .mdx-body h6,
  .mdx-body p,
  .mdx-body table,
  .mdx-body ol,
  .mdx-body ul,
  .mdx-body blockquote,
  .mdx-body pre,
  .mdx-body .callout,
  .mdx-body .image-container {
    margin: 2em 0;
  }

  /* MathJax renders equations inside mjx-container elements */
  .mdx-body mjx-container {
    /* MathJax ships with a default margin for mjx-container elements. Override it. */
    margin: 2em 0 !important;
  }

  .mdx-body li {
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }

  .mdx-body li > ol,
  .mdx-body li > ul {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .mdx-body hr {
    border: 0;
    height: 1px;
    background-color: var(--hr-color);
    margin: 4em 20%;
  }

  .mdx-body code {
    font-size: 0.9em;
    padding: 0.2em 0.4em;
    background-color: var(--post-secondary-bg-color);
    border-radius: 4px;
  }

  .mdx-body blockquote {
    margin-left: 0;
    padding: 1em 1em;
    background-color: var(--post-secondary-bg-color);
    border-left: 8px solid var(--post-secondary-bg-color-contrast);
    color: var(--post-secondary-color);
  }

  @media only screen and (max-width: 480px) {
    .mdx-body blockquote {
      margin-right: -16px;
    }
  }

  @media only screen and (min-width: 481px) {
    .mdx-body blockquote {
      margin-right: 0;
      border-radius: 0 8px 8px 0;
    }
  }

  .mdx-body blockquote :first-child {
    margin-top: 0;
  }

  .mdx-body blockquote :last-child {
    margin-bottom: 0;
  }

  .mdx-body pre.astro-code {
    padding: 1em;
    line-height: 1.2em;
  }

  .mdx-body pre.astro-code code {
    padding: 0;
    background-color: inherit;
    border-radius: 0;
  }

  @media only screen and (max-width: 480px) {
    .mdx-body pre.astro-code {
      margin-left: -16px;
      margin-right: -16px;
    }
  }

  @media only screen and (min-width: 481px) {
    .mdx-body pre.astro-code {
      border-radius: 8px;
    }
  }

  @media only screen and (max-width: 480px) {
    .mdx-body .callout {
      margin-left: -16px;
      margin-right: -16px;
    }
  }

  @media only screen and (max-width: 480px) {
    .mdx-body .image-container {
      margin-left: -16px;
      margin-right: -16px;
    }
  }

  .mdx-body table {
    min-width: 100%;
  }

  .mdx-body table,
  .mdx-body table th,
  .mdx-body table td {
    border: 1px solid var(--main-color);
    border-collapse: collapse;
  }

  .mdx-body table thead {
    background-color: var(--post-secondary-bg-color);
  }

  .mdx-body table th,
  .mdx-body table td {
    padding: 0.2em 0.5em;
  }

  .mdx-body blockquote p code,
  .mdx-body table code {
    background-color: var(--post-secondary-bg-color-contrast);
  }

  .mdx-body s {
    text-decoration-thickness: 1.5px;
  }
</style>
