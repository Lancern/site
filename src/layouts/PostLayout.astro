---
import type { MDXLayoutProps } from "astro";

import MDXLayout from "@layouts/MDXLayout.astro";
import BookmarkIcon from "@components/icon/BookmarkIcon.astro";
import CalendarIcon from "@components/icon/CalendarIcon.astro";
import CopyrightIcon from "@components/icon/CopyrightIcon.astro";
import TextWithIcon from "@components/TextWithIcon.astro";

import type { PostFrontmatter } from "@scripts/posts";

type Props = MDXLayoutProps<PostFrontmatter>;

const { frontmatter } = Astro.props;
---

<MDXLayout {...Astro.props}>
  <div class="post-meta-line" slot="meta">
    <div class="post-meta-item">
      <TextWithIcon>
        <CalendarIcon size="1.2em" slot="icon" />
        {new Date(frontmatter.date).toLocaleDateString()}
      </TextWithIcon>
    </div>
    <div class="post-meta-item">
      <TextWithIcon>
        <BookmarkIcon size="1.2em" slot="icon" />
        {frontmatter.category}
      </TextWithIcon>
    </div>
    <a
      class="post-meta-item"
      href="https://creativecommons.org/licenses/by-sa/4.0/"
      target="_blank"
    >
      <TextWithIcon>
        <CopyrightIcon size="1.2em" slot="icon" />
        CC BY-SA 2.0
      </TextWithIcon>
    </a>
  </div>
  <slot />
</MDXLayout>

<style>
  .post-meta-line {
    display: flex;
    justify-content: center;
    column-gap: 2em;
    font-size: 0.9em;
    color: #646464;
  }

  a.post-meta-item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  a.post-meta-item:hover {
    text-decoration: underline;
  }
</style>
