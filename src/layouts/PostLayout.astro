---
import "@styles/post.css";

import BaseLayout from "@layouts/BaseLayout.astro";
import BookmarkIcon from "@components/icon/BookmarkIcon.astro";
import CalendarIcon from "@components/icon/CalendarIcon.astro";
import CopyrightIcon from "@components/icon/CopyrightIcon.astro";
import TextWithIcon from "@components/TextWithIcon.astro";

import type { PostFrontmatter } from "@scripts/posts";

const frontmatter: PostFrontmatter = Astro.props.frontmatter;
---

<BaseLayout title={frontmatter.title + " - Lancern's Home"}>
  <main class="post">
    <header class="post-header">
      <h1 class="post-title">{frontmatter.title}</h1>
      <div class="post-meta-line">
        <div class="post-meta-item post-meta-date">
          <TextWithIcon>
            <CalendarIcon size="1.2em" slot="icon" />
            {new Date(frontmatter.date).toLocaleDateString()}
          </TextWithIcon>
        </div>
        <div class="post-meta-item post-meta-category">
          <TextWithIcon>
            <BookmarkIcon size="1.2em" slot="icon" />
            {frontmatter.category}
          </TextWithIcon>
        </div>
        <a
          class="post-meta-item post-meta-license"
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          target="_blank"
        >
          <TextWithIcon>
            <CopyrightIcon size="1.2em" slot="icon" />
            CC BY-SA 2.0
          </TextWithIcon>
        </a>
      </div>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </main>
</BaseLayout>

<style>
  .post-header {
    margin-top: 24px;
    margin-bottom: 32px;
  }

  .post-title {
    text-align: center;
    margin-bottom: 12px;
  }

  .post-meta-line {
    display: flex;
    justify-content: center;
    column-gap: 2em;
    font-size: 0.9em;
    color: #646464;
  }

  a.post-meta-item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  a.post-meta-item:hover {
    text-decoration: underline;
  }
</style>
