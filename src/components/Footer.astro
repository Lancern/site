---
import Container from "@components/Container.astro";
---

<footer>
  <Container>
    <div class="footer-main">
      <div class="footer-ack">
        <p>
          Built with ❤️ and <a href="https://astro.build/" target="_blank">Astro</a>
        </p>
        <p>
          Hosted on <a href="https://vercel.com/" target="_blank">Vercel</a>
        </p>
      </div>
      <div class="footer-copyright">
        <p>Copyright (c) Sirui Mu 2024</p>
      </div>
    </div>
  </Container>
</footer>

<style>
  footer {
    padding: 1.5rem 0;
    background-color: #eaeaea;
    color: #646464;
    font-size: 0.9rem;
  }

  footer p {
    margin: 5px 0;
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
  }
</style>
