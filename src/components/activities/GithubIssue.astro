---
interface Props {
  repo: string;
  number: number;
}

const { repo, number } = Astro.props;
const url = `https://github.com/${repo}/issues/${number}/`;
---

<a class="github-issue-link" href={url} target="_blank">
  #{number}
</a>

<style>
  .github-issue-link {
    color: var(--main-color);
    font-weight: bold;
    text-decoration: none;
  }
</style>
