---
interface Props {
  timestamp: string;
}

const { timestamp } = Astro.props;
const time = new Date(timestamp);
const now = new Date();

const full = time.toLocaleString();
const display = time.toDateString() === now.toDateString()
  ? time.toLocaleTimeString()
  : time.toLocaleDateString();
---

<abbr title={full}>{display}</abbr>
