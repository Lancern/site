---
import ActivityItem from "@components/activities/ActivityItem.astro";
import GithubUser from "@components/activities/GithubUser.astro";
import GithubIssue from "@components/activities/GithubIssue.astro";
import GithubRepo from "@components/activities/GithubRepo.astro";
import IssueInfo from "@components/activities/IssueInfo.astro";
import type { ActivityOf } from "@scripts/github-types";

interface Props {
  activity: ActivityOf<"IssuesEvent">;
}

const { activity } = Astro.props;
const userName = activity.actor.login;
const repoName = activity.repo.name;

const message = (() => {
  switch (activity.payload.action) {
    case "opened":
      return "opened issue";
    case "closed":
      return "closed issue";
    case "reopened":
      return "reopened issue";
  }
})();

const issue = activity.payload.issue;
const issueNumber: number = issue.number;
const issueTitle: string = issue.title;
---

<ActivityItem timestamp={activity.created_at}>
  <span slot="title">
    <GithubUser login={userName} />
    {message}
    <GithubIssue repo={repoName} number={issueNumber} />
    in the repository
    <GithubRepo name={repoName} />
  </span>
  <IssueInfo repoName={repoName} issueNumber={issueNumber} issueTitle={issueTitle} />
</ActivityItem>
