---
import ActivityContent from "./ActivityContent.astro";

interface Props {
  repoName: string;
  prNumber: number;
  prTitle: string;
}

const { repoName, prNumber, prTitle } = Astro.props;
---

<ActivityContent>
  <h4 class="github-repo-name">{repoName}</h4>
  <h3 class="github-pr-title">
    #{prNumber}: {prTitle}
  </h3>
</ActivityContent>

<style>
  .github-repo-name {
    font-size: 0.8em;
    font-weight: normal;
    color: var(--secondary-color);
    margin: 0.2em 0;
  }

  .github-pr-title {
    font-size: 1em;
    margin: 0.4em 0;
  }
</style>
