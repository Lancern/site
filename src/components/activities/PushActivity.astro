---
import ActivityItem from "@components/activities/ActivityItem.astro";
import CommitsInfo from "@components/activities/CommitsInfo.astro";
import GithubUser from "@components/activities/GithubUser.astro";
import GithubRepo from "@components/activities/GithubRepo.astro";
import type { Activity } from "@scripts/activities";

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;
const userName = activity.actor.login;
const repoName = activity.repo.name;

const numCommits = (activity.payload as any).distinct_size;
const gitRef = (activity.payload as any).ref;

const commits = (activity.payload as any).commits
  .filter((commit: any) => commit.distinct)
  .map((commit: any) => ({
    hash: commit.sha,
    message: commit.message,
    author: commit.author.name,
  }));
---

<ActivityItem timestamp={activity.created_at!}>
  <span slot="title">
    <GithubUser login={userName} />
    pushed {numCommits} commit(s) to {gitRef} in repository
    <GithubRepo name={repoName} />
  </span>
  <CommitsInfo repo={repoName} commits={commits} />
</ActivityItem>
