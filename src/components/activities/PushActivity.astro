---
import ActivityItem from "@components/activities/ActivityItem.astro";
import ActivityContent from "@components/activities/ActivityContent.astro";
import GithubUser from "@components/activities/GithubUser.astro";
import GithubRepo from "@components/activities/GithubRepo.astro";
import type { ActivityOf } from "@scripts/github-types";

interface Props {
  activity: ActivityOf<"PushEvent">;
}

const { activity } = Astro.props;
const userName = activity.actor.login;
const repoName = activity.repo.name;
const { ref, head, before } = activity.payload;

function getRefKind(ref: string): string {
  if (ref.startsWith("refs/heads/")) {
    return "branch";
  }

  if (ref.startsWith("refs/tags/")) {
    return "tag";
  }

  return "ref";
}

function getRefName(ref: string): string {
  return ref.replace(/^refs\/heads\//, "").replace(/^refs\/tags\//, "");
}

function getCommitUrl(repo: string, commitHash: string): string {
  return `https://github.com/${repo}/commit/${commitHash}/`;
}

function getShortHash(commitHash: string): string {
  return commitHash.substring(0, 7);
}

function isZeroHash(commitHash: string): boolean {
  return /^0+$/.test(commitHash);
}

const refKind = getRefKind(ref);
const refName = getRefName(ref);
const beforeIsZero = isZeroHash(before);
const headIsZero = isZeroHash(head);
---

<ActivityItem timestamp={activity.created_at}>
  <span slot="title">
    <GithubUser login={userName} />
    pushed to {refKind}
    {refName} in repository
    <GithubRepo name={repoName} />
  </span>
  <ActivityContent>
    <h4 class="github-repo-name">{repoName}</h4>
    <div class="push-details">
      <span class="push-ref">{refKind} {refName}</span>
      {
        beforeIsZero ? (
          <span>created at</span>
        ) : (
          <Fragment>
            <span>updated from</span>
            <a class="commit-hash" href={getCommitUrl(repoName, before)} target="_blank">
              #{getShortHash(before)}
            </a>
            <span>to</span>
          </Fragment>
        )
      }
      {
        headIsZero ? (
          <span class="commit-hash">deleted</span>
        ) : (
          <a class="commit-hash" href={getCommitUrl(repoName, head)} target="_blank">
            #{getShortHash(head)}
          </a>
        )
      }
    </div>
  </ActivityContent>
</ActivityItem>

<style>
  .github-repo-name {
    font-size: 0.8em;
    font-weight: normal;
    color: var(--secondary-color);
    margin: 0.2em 0;
  }

  .push-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    align-items: baseline;
    font-size: 0.95em;
  }

  .push-ref,
  .commit-hash {
    font-weight: bold;
  }

  .commit-hash {
    text-decoration: none;
  }
</style>
