---
interface Props {
  name: string;
}

const {name} = Astro.props;
const url = `https://github.com/${name}/`;
---

<a class="github-repo-link" href={url} target="_blank">
  {name}
</a>

<style>
  .github-repo-link {
    color: var(--main-color);
    font-weight: bold;
    text-decoration: none;
  }
</style>
