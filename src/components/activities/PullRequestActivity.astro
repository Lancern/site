---
import ActivityItem from "@components/activities/ActivityItem.astro";
import GithubUser from "@components/activities/GithubUser.astro";
import GithubPullRequest from "@components/activities/GithubPullRequest.astro";
import GithubRepo from "@components/activities/GithubRepo.astro";
import PullRequestInfo from "@components/activities/PullRequestInfo.astro";
import type { ActivityOf } from "@scripts/github-types";

interface Props {
  activity: ActivityOf<"PullRequestEvent">;
}

const { activity } = Astro.props;
const userName = activity.actor.login;
const repoName = activity.repo.name;

const message = (() => {
  switch (activity.payload.action) {
    case "opened":
      return "opened pull request";
    case "closed":
      return "closed pull request";
    case "merged":
      return "merged pull request";
    case "reopened":
      return "reopened pull request";
    case "assigned":
      return "assigned pull request";
    case "unassigned":
      return "unassigned pull request";
    case "labeled":
      return "labeled pull request";
    case "unlabeled":
      return "unlabeled pull request";
  }
})();

const pr = activity.payload.pull_request;
const prNumber: number = pr.number;
const prTitle = pr.title;
---

<ActivityItem timestamp={activity.created_at}>
  <span slot="title">
    <GithubUser login={userName} />
    {message}
    <GithubPullRequest repo={repoName} number={prNumber} />
    in the repository
    <GithubRepo name={repoName} />
  </span>
  <PullRequestInfo repoName={repoName} prNumber={prNumber} prTitle={prTitle} />
</ActivityItem>
