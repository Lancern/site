---
import ActivityTime from "@components/activities/ActivityTime.astro";

interface Props {
  timestamp: string;
}

const { timestamp } = Astro.props;
---

<div class="activity">
  <div class="activity-header">
    <h2 class="activity-title">
      <slot name="title" />
    </h2>
    <h3 class="activity-time">
      <ActivityTime timestamp={timestamp} />
    </h3>
  </div>
  <div class="activity-body">
    <slot />
  </div>
</div>

<style>
  .activity {
    border: 1px solid var(--card-border-color);
    border-radius: 6px;
  }

  .activity-header {
    border-bottom: 1px solid var(--card-border-color);
    background-color: var(--card-header-bg-color);
    padding: 0.75em 1em;
    display: flex;
    justify-content: space-between;
  }

  .activity-body {
    padding: 0.75em 1em;
  }

  .activity-time {
    color: var(--secondary-color);
    font-size: 0.8em;
    font-weight: normal;
    margin: 0 0 0.2em 0;
  }

  .activity-title {
    color: var(--secondary-color);
    font-size: 1em;
    font-weight: normal;
    margin: 0;
  }
</style>
