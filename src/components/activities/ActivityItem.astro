---
interface Props {
  timestamp: string;
}

const { timestamp } = Astro.props;
---

<div class="activity">
  <div class="activity-header">
    <div class="activity-timeline-dot"></div>
    <div class="activity-time-box">
      <abbr class="activity-time" title={timestamp} data-activity-time>
        <!-- This will be filled by client-side JavaScript. -->
      </abbr>
    </div>
  </div>
  <div class="activity-body">
    <h2 class="activity-title">
      <slot name="title" />
    </h2>
    <slot />
  </div>
</div>

<style>
  .activity {
    padding: 0 1em;
  }

  .activity-header {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .activity-timeline-dot {
    width: 8px;
    height: 8px;
    background-color: var(--timeline-dot-color);
    border-radius: 8px;
  }

  .activity-time {
    color: var(--secondary-color);
    text-decoration: none;
    font-size: 0.9em;
  }

  .activity-body {
    margin: -4px 0 -4px 3px;
    border-left: 2px solid var(--timeline-color);
    padding: 1.5em 1em;
    padding-bottom: calc(1.5em + 4px);
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .activity-title {
    font-size: 1em;
    font-weight: normal;
    margin: 0;
  }
</style>

<script>
  const nowDate = new Date().toDateString();

  const timeElements = document.querySelectorAll("[data-activity-time]");
  for (const el of timeElements) {
    const abbrElem = el as HTMLElement;

    const activityTime = new Date(abbrElem.title);
    const displayTime =
      activityTime.toDateString() === nowDate
        ? activityTime.toLocaleTimeString()
        : activityTime.toLocaleDateString();

    abbrElem.title = activityTime.toLocaleString();
    abbrElem.innerHTML = displayTime;
  }
</script>
