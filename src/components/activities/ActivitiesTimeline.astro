---
import CommitCommentActivity from "@components/activities/CommitCommentActivity.astro";
import CreateActivity from "@components/activities/CreateActivity.astro";
import DeleteActivity from "@components/activities/DeleteActivity.astro";
import ForkActivity from "@components/activities/ForkActivity.astro";
import GollumActivity from "@components/activities/GollumActivity.astro";
import IssueActivity from "@components/activities/IssueActivity.astro";
import IssueCommentActivity from "@components/activities/IssueCommentActivity.astro";
import MemberActivity from "@components/activities/MemberActivity.astro";
import PublicActivity from "@components/activities/PublicActivity.astro";
import PullRequestActivity from "@components/activities/PullRequestActivity.astro";
import PullRequestReviewActivity from "@components/activities/PullRequestReviewActivity.astro";
import PullRequestReviewCommentActivity from "@components/activities/PullRequestReviewCommentActivity.astro";
import PushActivity from "@components/activities/PushActivity.astro";
import ReleaseActivity from "@components/activities/ReleaseActivity.astro";
import SponsorshipActivity from "@components/activities/SponsorshipActivity.astro";
import WatchActivity from "@components/activities/WatchActivity.astro";
import type { Activity, ActivityArray } from "@scripts/activities";

interface Props {
  activities: ActivityArray;
}

const { activities } = Astro.props;
---

<div class="activities">
  {
    activities.map((act: Activity) => {
      switch (act.type) {
        case "CommitCommentEvent":
          return <CommitCommentActivity activity={act} />;

        case "CreateEvent":
          return <CreateActivity activity={act} />;

        case "DeleteEvent":
          return <DeleteActivity activity={act} />;

        case "ForkEvent":
          return <ForkActivity activity={act} />;

        case "GollumEvent":
          return <GollumActivity activity={act} />;

        case "IssueCommentEvent":
          return <IssueCommentActivity activity={act} />;

        case "IssuesEvent":
          return <IssueActivity activity={act} />;

        case "MemberEvent":
          return <MemberActivity activity={act} />;

        case "PublicEvent":
          return <PublicActivity activity={act} />;

        case "PullRequestEvent":
          return <PullRequestActivity activity={act} />

        case "PullRequestReviewEvent":
          return <PullRequestReviewActivity activity={act} />;

        case "PullRequestReviewCommentEvent":
          return <PullRequestReviewCommentActivity activity={act} />;

        case "PushEvent":
          return <PushActivity activity={act} />;

        case "ReleaseEvent":
          return <ReleaseActivity activity={act} />;

        case "SponsorshipEvent":
          return <SponsorshipActivity activity={act} />;

        case "WatchEvent":
          return <WatchActivity activity={act} />;

        default: {
          console.log("unknown activity type: ", act.type);
          return <></>;
        }
      }
    })
  }
</div>
