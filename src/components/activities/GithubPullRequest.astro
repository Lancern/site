---
interface Props {
  repo: string;
  number: number;
}

const { repo, number } = Astro.props;
const url = `https://github.com/${repo}/pull/${number}/`;
---

<a class="github-pr-link" href={url} target="_blank">
  #{number}
</a>

<style>
  .github-pr-link {
    font-weight: bold;
    text-decoration: none;
  }
</style>
