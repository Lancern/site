---
interface Props {
  login: string;
}

const { login } = Astro.props;
const url = `https://github.com/${login}/`;
---

<a class="github-user-link" href={url} target="_blank">
  {login}
</a>

<style>
  .github-user-link {
    color: var(--main-color);
    font-weight: bold;
    text-decoration: none;
  }
</style>
