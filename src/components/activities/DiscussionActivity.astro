---
import ActivityContent from "@components/activities/ActivityContent.astro";
import ActivityItem from "@components/activities/ActivityItem.astro";
import GithubRepo from "@components/activities/GithubRepo.astro";
import GithubUser from "@components/activities/GithubUser.astro";
import type { ActivityOf } from "@scripts/github-types";

interface Props {
  activity: ActivityOf<"DiscussionEvent">;
}

const { activity } = Astro.props;
const userName = activity.actor.login;
const repoName = activity.repo.name;
const discussion = activity.payload.discussion;
---

<ActivityItem timestamp={activity.created_at}>
  <span slot="title">
    <GithubUser login={userName} />
    created a discussion in repository
    <GithubRepo name={repoName} />
  </span>
  <ActivityContent>
    <h4 class="github-repo-name">{repoName}</h4>
    <h3 class="github-discussion-title">
      <a href={discussion.html_url} target="_blank">
        {discussion.number ? `#${discussion.number}: ` : ""}{discussion.title}
      </a>
    </h3>
  </ActivityContent>
</ActivityItem>

<style>
  .github-repo-name {
    font-size: 0.8em;
    font-weight: normal;
    color: var(--secondary-color);
    margin: 0.2em 0;
  }

  .github-discussion-title {
    font-size: 1em;
    margin: 0.4em 0;
  }

  .github-discussion-title a {
    color: inherit;
    text-decoration: none;
  }
</style>
