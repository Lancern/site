---
import ActivityItem from "@components/activities/ActivityItem.astro";
import GithubUser from "@components/activities/GithubUser.astro";
import GithubRepo from "@components/activities/GithubRepo.astro";
import type { ActivityOf } from "@scripts/github-types";

interface Props {
  activity: ActivityOf<"GollumEvent">;
}

const { activity } = Astro.props;
const userName = activity.actor.login;
const repoName = activity.repo.name;
---

<ActivityItem timestamp={activity.created_at}>
  <span slot="title">
    <GithubUser login={userName} />
    updated wiki pages in the repository
    <GithubRepo name={repoName} />
  </span>
</ActivityItem>
