---
import BookmarkIcon from "@components/icon/BookmarkIcon.astro";
import CalendarIcon from "@components/icon/CalendarIcon.astro";
import TagIcon from "@components/icon/TagIcon.astro";
import Tag from "@components/Tag.astro";
import TextWithIcon from "@components/TextWithIcon.astro";
import type { PostFrontmatter } from "@scripts/posts";

interface Props {
  frontmatter: PostFrontmatter;
  url: string;
}

const { frontmatter, url } = Astro.props;
---

<div>
  <a class="title-line" href={url}>{frontmatter.title}</a>
  <div class="meta-line">
    <div class="post-meta-item post-meta-date">
      <TextWithIcon>
        <CalendarIcon size="1.2em" slot="icon" />
        {new Date(frontmatter.date).toLocaleDateString()}
      </TextWithIcon>
    </div>
    {
      frontmatter.category && (
        <div class="post-meta-item post-meta-category">
          <TextWithIcon>
            <BookmarkIcon size="1.2em" slot="icon" />
            <Tag name={frontmatter.category} category />
          </TextWithIcon>
        </div>
      )
    }
    {
      frontmatter.tags && (
        <div class="post-meta-item post-meta-tags">
          <TextWithIcon>
            <TagIcon size="1.2em" slot="icon" />
            <div class="tags-row">
              {frontmatter.tags.map((tag) => (
                <span class="tag-container">
                  <Tag name={tag} />
                </span>
              ))}
            </div>
          </TextWithIcon>
        </div>
      )
    }
  </div>
</div>

<style>
  .title-line {
    display: block;
    margin-bottom: 0.4em;
    text-decoration: none;
    color: var(--main-color);
    font-size: 1.3em;
    font-weight: bold;
  }

  .title-line:hover {
    text-decoration: underline;
  }

  .meta-line {
    display: flex;
    column-gap: 2em;
    row-gap: 0.5em;
    flex-wrap: wrap;
    color: var(--secondary-color);
    stroke: var(--secondary-color);
    font-size: 0.9em;
  }

  .tags-row {
    display: inline;
  }

  .tag-container::before {
    content: ",";
  }

  .tag-container:first-child::before {
    content: none;
  }
</style>
