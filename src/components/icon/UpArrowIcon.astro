---
import type { IconProps } from "./typing";
import IconSVG from "./IconSVG.astro";

type Props = IconProps;

const { size } = Astro.props;
---

<IconSVG size={size} fill="none">
  <path
    d="M12 20L12 4M12 4L18 10M12 4L6 10"
    stroke="#1C274C"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</IconSVG>
