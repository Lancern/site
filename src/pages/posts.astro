---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostList, { type PostInfo } from "@components/PostList.astro";
import { filterAndSortPosts, type PostInstance } from "@scripts/posts";

const allPosts = Object.values(
  import.meta.glob<PostInstance>("./posts/**/*.{md,mdx}", { eager: true }),
);
const posts = filterAndSortPosts(allPosts) as PostInfo[];
---

<BaseLayout title="Posts - Lancern's Home">
  <PostList posts={posts} />
</BaseLayout>
