---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostList, { type PostInfo } from "@components/PostList.astro";
import { filterAndSortPosts, type PostInstance } from "@scripts/posts";

// FIXME: Astro.glob is deprecated in Astro v5.0, see:
// https://docs.astro.build/en/reference/api-reference/#astroglob
const allPosts = await Astro.glob<PostInstance>("../pages/posts/**/*.{md,mdx}");
const posts = filterAndSortPosts(allPosts) as PostInfo[];
---

<BaseLayout title="Posts - Lancern's Home">
  <PostList posts={posts} />
</BaseLayout>
