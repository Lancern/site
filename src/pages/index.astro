---
import BaseLayout from "@layouts/BaseLayout.astro";
import TypeWriter from "@components/TypeWriter.astro";
import ArchiveIcon from "@components/icon/ArchiveIcon.astro";
import InfoIcon from "@components/icon/InfoIcon.astro";
import PeopleIcon from "@components/icon/PeopleIcon.astro";
import TextWithIcon from "@components/TextWithIcon.astro";

const keywords = [
  "C/C++",
  "Rust",
  "Python",
  "TypeScript",
  "compiler",
  "toolchain",
  "backend",
  "frontend",
];
---

<BaseLayout title="Lancern's Home" hideHeader>
  <div class="home">
    <div class="identity-line">
      <img class="identity-avatar" src="/avatar.jpeg" height="64" width="64" />
      <span class="identity-name">Lancern</span>
    </div>
    <div class="description-line">
      <p>
        I'm a
        <TypeWriter textList={keywords} />
        developer in China
      </p>
    </div>
    <div class="nav-line">
      <a class="nav-link" href="/posts">
        <TextWithIcon>
          <ArchiveIcon size="1.2em" slot="icon" />
          Posts
        </TextWithIcon>
      </a>
      <a class="nav-link" href="/about">
        <TextWithIcon>
          <InfoIcon size="1.2em" slot="icon" />
          About
        </TextWithIcon>
      </a>
      <a class="nav-link" href="/friends">
        <TextWithIcon>
          <PeopleIcon size="1.2em" slot="icon" />
          Friends
        </TextWithIcon>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding: 8rem 0;
  }

  .identity-line {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .identity-avatar {
    border-radius: 50%;
  }

  .identity-name {
    display: block;
    margin-left: 1rem;
    font-size: 1.8rem;
    font-weight: bold;
  }

  .description-line {
    display: flex;
    justify-content: center;
    margin: 1.6rem 0;
    font-size: 1.6rem;
  }

  .nav-line {
    display: flex;
    justify-content: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    padding: 1rem 2rem;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    color: black;
  }

  .nav-link:hover {
    text-decoration: underline;
  }
</style>
