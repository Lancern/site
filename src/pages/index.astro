---
import BaseLayout from "@layouts/BaseLayout.astro";
import TypeWriter from "@components/TypeWriter.astro";
import ArchiveIcon from "@components/icon/ArchiveIcon.astro";
import InfoIcon from "@components/icon/InfoIcon.astro";
import PeopleIcon from "@components/icon/PeopleIcon.astro";
import TextWithIcon from "@components/TextWithIcon.astro";
import GithubIcon from "@components/icon/GithubIcon.astro";
import ChartIcon from "@components/icon/ChartIcon.astro";
import LightbulbIcon from "@components/icon/LightbulbIcon.astro";

const keywords = [
  "C/C++",
  "Rust",
  "Python",
  "TypeScript",
  "compiler",
  "toolchain",
  "backend",
  "frontend",
];
---

<BaseLayout title="Lancern's Home" hideHeader>
  <div class="home">
    <div class="identity-line">
      <img class="identity-avatar" src="/avatar.jpeg" height="64" width="64" />
      <span class="identity-name">Lancern</span>
    </div>
    <div class="description-line hide-on-phones">
      <p>
        I'm a
        <TypeWriter textList={keywords} />
        developer in China
      </p>
    </div>
    <div class="nav-block">
      <div class="nav-line">
        <a class="nav-link" href="/posts">
          <TextWithIcon>
            <ArchiveIcon size="1.2em" slot="icon" />
            <span class="nav-link-text">Posts</span>
          </TextWithIcon>
        </a>
        <a class="nav-link" href="https://chan.lancern.xyz">
          <TextWithIcon>
            <ChartIcon size="1.2em" slot="icon" />
            <span class="nav-link-text">Channel</span>
          </TextWithIcon>
        </a>
        <a class="nav-link" href="/activities">
          <TextWithIcon>
            <LightbulbIcon size="1.2em" slot="icon" />
            <span class="nav-link-text">Activities</span>
          </TextWithIcon>
        </a>
      </div>
      <div class="nav-line">
        <a class="nav-link" href="https://github.com/Lancern" target="_blank">
          <TextWithIcon>
            <GithubIcon size="1.2em" slot="icon" />
            <span class="nav-link-text">GitHub</span>
          </TextWithIcon>
        </a>
        <a class="nav-link" href="/about">
          <TextWithIcon>
            <InfoIcon size="1.2em" slot="icon" />
            <span class="nav-link-text">About</span>
          </TextWithIcon>
        </a>
        <a class="nav-link" href="/friends">
          <TextWithIcon>
            <PeopleIcon size="1.2em" slot="icon" />
            <span class="nav-link-text">Friends</span>
          </TextWithIcon>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @media only screen and (max-width: 480px) {
    .home {
      padding: 3rem 0;
    }
  }

  @media only screen and (min-width: 481px) {
    .home {
      padding: 8rem 0;
    }
  }

  .identity-line {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.6rem;
  }

  .identity-avatar {
    border-radius: 50%;
  }

  .identity-name {
    display: block;
    margin-left: 1rem;
    font-size: 1.8rem;
    font-weight: bold;
  }

  .description-line {
    display: flex;
    justify-content: center;
    margin: 1.6rem 0;
    font-size: 1.6rem;
  }

  .nav-block {
    margin-top: 2rem;
  }

  .nav-line {
    display: flex;
  }

  @media only screen and (max-width: 480px) {
    .nav-line {
      flex-direction: column;
      align-items: center;
    }
  }

  @media only screen and (min-width: 481px) {
    .nav-line {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  .nav-link {
    padding: 1rem 2rem;
    width: 200px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--main-color);
    stroke: var(--main-color);
  }

  .nav-link:hover {
    background-color: var(--button-hover-color);
  }
  .nav-link:focus {
    background-color: var(--button-focus-color);
  }
</style>
