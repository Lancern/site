---
import BaseLayout from "@layouts/BaseLayout.astro";
import TagIcon from "@components/icon/TagIcon.astro";
import PostList, { type PostInfo } from "@components/PostList.astro";
import { filterAndSortPosts, getPostTags, type PostInstance } from "@scripts/posts";

export function getStaticPaths() {
  const allPosts = Object.values(
    import.meta.glob<PostInstance>("../**/*.{md,mdx}", { eager: true }),
  );
  const tags = getPostTags(allPosts);
  return tags.map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const allPosts = Object.values(
  import.meta.glob<PostInstance>("../**/*.{md,mdx}", { eager: true }),
);
const posts = filterAndSortPosts(allPosts, { tag }) as PostInfo[];
---

<BaseLayout title={`Tag: ${tag} - Lancern's Home`}>
  <h1 class="title">
    <TagIcon size="1.2em" />
    {tag}
  </h1>
  <PostList posts={posts} />
</BaseLayout>

<style>
  .title {
    stroke: var(--main-color);
    font-size: 1.8rem;
    margin-top: 0;
    margin-bottom: 2rem;
  }
</style>
